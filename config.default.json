{
  "tmdb": "tmdb-api-key",
  "region": "en-US",
  "adult": false,
  "blackhole": "/blackhole",
  "shows": {
    "library": "/tvshows",
    "blackhole": "/tvshows/.blackhole",
    "staging": "/tvshows/.staging"
  },
  "jobs": {
    "keep-in-touch": {
      "cron": "0 16 * * *",
      "paused": false
    },
    "record": {
      "cron": "0 17 * * *",
      "paused": false,
      "proposalOnly": true
    },
    "sync": {
      "cron": "0 1 * * *",
      "paused": false,
      "cleanup": false
    },
    "refresh": {
      "cron": "0 3 * * 0",
      "paused": false
    },
    "refine": {
      "cron": "0 23 1 * *",
      "paused": false,
      "proposalOnly": true
    },
    "shrink": {
      "cron": "0 5 * * 0",
      "paused": false,
      "proposalOnly": true
    },
    "report": {
      "cron": "0 * * * *",
      "paused": true,
      "proposalOnly": true
    },
    "refresh-shows": {
      "cron": "0 4 * * *",
      "paused": true
    },
    "sync-shows": {
      "cron": "0 2 * * *",
      "paused": true
    },
    "import-shows": {
      "cron": "*/10 * * * *",
      "paused": true
    }
  },
  "plex": {},
  "znabs": [],
  "policies": []
}
